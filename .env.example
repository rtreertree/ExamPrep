# Use a dedicated Neon development/test branch locally.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
BETTER_AUTH_SECRET=
# Separate stable random secret (32+ characters). Back it up; changing it makes
# existing password hashes unverifiable. Never store this value in the database.
PASSWORD_PEPPER=
BETTER_AUTH_URL=http://127.0.0.1:8787
PORT=8787
# Optional password recovery. Use a verified Resend sender and a sending-only key.
RESEND_API_KEY=
RESET_EMAIL_FROM=
