{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "kind": {
          "type": "string",
          "const": "exam"
        },
        "questions": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$"
                  },
                  "type": {
                    "type": "string",
                    "const": "single_choice"
                  },
                  "prompt": {
                    "type": "string",
                    "maxLength": 20000,
                    "minLength": 1
                  },
                  "options": {
                    "minItems": 2,
                    "maxItems": 6,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{1,64}$"
                        },
                        "text": {
                          "type": "string",
                          "maxLength": 20000,
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id",
                        "text"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "answer": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$"
                  },
                  "explanation": {
                    "type": "string",
                    "maxLength": 20000
                  }
                },
                "required": [
                  "id",
                  "type",
                  "prompt",
                  "options",
                  "answer"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,64}$"
                  },
                  "type": {
                    "type": "string",
                    "const": "written"
                  },
                  "prompt": {
                    "type": "string",
                    "maxLength": 20000,
                    "minLength": 1
                  },
                  "answer": {
                    "type": "string",
                    "maxLength": 20000,
                    "minLength": 1
                  },
                  "answerType": {
                    "type": "string",
                    "enum": [
                      "simple",
                      "math",
                      "chem"
                    ],
                    "description": "Preferred written-answer keyboard. Omission behaves as simple. Answers remain Markdown/LaTeX strings; grading is unchanged."
                  },
                  "explanation": {
                    "type": "string",
                    "maxLength": 20000
                  },
                  "rubric": {
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-]{1,64}$"
                        },
                        "description": {
                          "type": "string",
                          "maxLength": 20000,
                          "minLength": 1
                        },
                        "points": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        }
                      },
                      "required": [
                        "id",
                        "description",
                        "points"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "prompt",
                  "answer"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "title",
        "kind",
        "questions"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "kind": {
          "type": "string",
          "const": "flashcards"
        },
        "cards": {
          "minItems": 1,
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$"
              },
              "front": {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              },
              "back": {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              }
            },
            "required": [
              "id",
              "front",
              "back"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "title",
        "kind",
        "cards"
      ],
      "additionalProperties": false
    }
  ],
  "title": "Exam Prep version 1",
  "$comment": "Additional application validation is required. See VALIDATION.md: duplicate JSON keys; UTF-8/byte limits; nonblank Unicode strings; unique local IDs; answer references; allowed Markdown/LaTeX."
}
