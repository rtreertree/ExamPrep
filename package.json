{
  "name": "exam-prep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "tsx watch --env-file=.env server/node.ts",
    "dev:worker": "wrangler dev --port 8787",
    "generate": "prisma generate && node --import tsx scripts/assets.ts",
    "build": "npm run generate && tsc --noEmit && vite build && esbuild server/node.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mock": "playwright test --project=mocked",
    "db:migrate": "node scripts/migrate.mjs",
    "worker:check": "wrangler deploy --env=\"\" --dry-run --outdir dist/worker",
    "cloudflare:check": "node --import tsx scripts/free-tier-check.ts",
    "deploy:worker": "npm run build && npm run worker:check && npm run deploy:production",
    "start": "node dist/server.js",
    "test:acceptance": "node --import tsx scripts/acceptance.ts",
    "deploy:production": "node scripts/deploy-production.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@hono/node-server": "2.1.6",
    "@neondatabase/serverless": "1.2.0",
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "1.7.18",
    "dotenv": "18.0.9",
    "hono": "4.13.17",
    "idb": "8.0.4",
    "katex": "0.19.1",
    "lucide-react": "1.70.0",
    "mathlive": "0.111.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.5",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261108.1",
    "@playwright/test": "1.65.0",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "jsonc-parser": "3.3.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "overrides": {
    "katex": "$katex"
  }
}
