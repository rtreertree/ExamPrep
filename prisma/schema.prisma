generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
}

generator workerClient {
  provider = "prisma-client"
  output   = "../generated/worker"
  runtime  = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  role          String     @default("user")
  suspended     Boolean    @default(false)
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  studySets     StudySet[]
  attempts      Attempt[]
  conversions   CloneConversion[]
  invitations   StudySetInvitation[]
  copyImports   StudySetCopyImport[]
  libraryFolders LibraryFolder[]
  libraryEntries LibraryEntry[]
  setOperations StudySetOperation[]
  backupRestores BackupSetRestore[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_name_search")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_email_search")
  @@index([role, suspended, id])
  @@index([suspended, id])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model LibraryFolder {
  id         String @id @default(uuid())
  userId     String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  manualRank BigInt @default(dbgenerated("nextval('library_manual_rank_seq'::regclass)"))
  entries    LibraryEntry[]

  @@unique([userId, id])
  @@unique([userId, name])
}

model StudySet {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String @default(dbgenerated())
  kind          String @default(dbgenerated())
  published     Boolean      @default(false)
  content       Json
  contentFingerprint String @default(dbgenerated())
  revision      Int          @default(1)
  // The cutover keeps these columns for reconciliation until the legacy cleanup migration.
  course        String @default("") @ignore
  folderId      String? @ignore
  manualRank    BigInt @default(dbgenerated("nextval('library_manual_rank_seq'::regclass)")) @ignore
  pinned        Boolean @default(false) @ignore
  archived      Boolean @default(false) @ignore
  lastStudiedAt DateTime? @ignore
  reviewLimit   Int @default(20) @ignore
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  attempts      Attempt[]
  entries       LibraryEntry[]
  ownerEntry    LibraryEntry @relation("PrimaryEntry", fields: [userId, id], references: [userId, studySetId], onDelete: NoAction, onUpdate: NoAction, map: "StudySet_owner_entry_fkey")
  invitations   StudySetInvitation[]
  copyLink      StudySetCopyLink?
  copyImport    StudySetCopyImport?

  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "study_set_title_search")
  @@index([published, kind, id])
  @@index([published, id])
  @@index([userId, updatedAt])
  @@index([userId, contentFingerprint])
  @@index([userId, archived, pinned, lastStudiedAt])
  @@index([userId, folderId, archived, manualRank])
  @@unique([userId, id])
}

model LibraryEntry {
  userId        String
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySetId    String
  studySet      StudySet @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  primarySet    StudySet? @relation("PrimaryEntry")
  folderId      String?
  folder        LibraryFolder? @relation(fields: [userId, folderId], references: [userId, id], onDelete: NoAction)
  manualRank    BigInt @default(dbgenerated("nextval('library_manual_rank_seq'::regclass)"))
  pinned        Boolean @default(false)
  archived      Boolean @default(false)
  lastStudiedAt DateTime?
  reviewLimit   Int @default(20)
  coOwner       Boolean @default(false)
  discovered    Boolean @default(false)
  linkNonce     String?
  cardReviews   CardReview[]

  @@id([userId, studySetId])
  @@index([studySetId, userId])
  @@index([userId, archived, pinned, lastStudiedAt])
  @@index([userId, folderId, archived, manualRank])
}

model StudySetInvitation {
  id         String   @id @default(uuid())
  studySetId String
  studySet   StudySet @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([studySetId, userId])
  @@index([userId, createdAt])
}

model StudySetCopyLink {
  studySetId String   @id
  studySet   StudySet @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  guestAccess Boolean @default(false)
  nonce      String   @unique
}

model StudySetCopyImport {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String
  linkNonce String
  copyId    String?   @unique
  copy      StudySet? @relation(fields: [copyId], references: [id], onDelete: SetNull)

  @@id([userId, requestId])
}

model CardReview {
  userId           String
  studySetId       String
  entry            LibraryEntry @relation(fields: [userId, studySetId], references: [userId, studySetId], onDelete: Cascade, map: "CardReview_entry_fkey")
  cardId           String
  fingerprint      String
  streak           Int
  dueAt            DateTime
  attemptStartedAt DateTime

  @@id([userId, studySetId, cardId], map: "CardReview_entry_pkey")
}

model Attempt {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySetId       String?
  studySet         StudySet? @relation(fields: [studySetId], references: [id], onDelete: SetNull)
  sourceAttemptId  String?
  sourceAttempt    Attempt?  @relation("Retries", fields: [sourceAttemptId], references: [id], onDelete: SetNull)
  retries          Attempt[] @relation("Retries")
  snapshotVersion  Int       @default(0)
  progressContent  Json?
  snapshot         Json
  studySetRevision Int?
  settings         Json      @default("{}")
  reviewMode       Boolean   @default(false)
  fullSet          Boolean   @default(true)
  status           String    @default("in_progress")
  responses        Json      @default("{}")
  position         Int       @default(0)
  result           Json?
  revision         Int       @default(1)
  startedAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?

  @@index([userId, startedAt])
  @@index([studySetId])
  @@index([sourceAttemptId])
  @@index([studySetId, reviewMode, completedAt])
}

// Historical inventory and recovery records are retained independently of the live set.
model CloneConversion {
  copyId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  sourceId String?
  recovery Json?
  convertedAt DateTime?
  restoredCopyId String?
  @@index([userId, sourceId])
}

model LiveSetCutover {
  id Int @id
  completedAt DateTime?
}

model StudySetOperation {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String
  operation String
  inputIdentity String
  setId String?
  reused Boolean @default(false)
  resultRevision Int?

  @@id([userId, requestId])
}

model BackupSetRestore {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupId String
  sourceId String
  setId String
  contentFingerprint String
  destinationRevision Int

  @@id([userId, backupId, sourceId])
  @@unique([userId, backupId, setId])
}
