generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "nodejs"
}

generator workerClient {
  provider = "prisma-client"
  output   = "../generated/worker"
  runtime  = "cloudflare"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String     @id
  name          String
  email         String     @unique
  role          String     @default("user")
  suspended     Boolean    @default(false)
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  sessions      Session[]
  accounts      Account[]
  studySets     StudySet[]
  attempts      Attempt[]
  conversions   CloneConversion[]
  viewerSets    StudySetViewer[]
  coOwnedSets   StudySetCoOwner[]
  invitations   StudySetInvitation[]
  copyImports   StudySetCopyImport[]
  libraryFolders LibraryFolder[]
  setOperations StudySetOperation[]
  backupRestores BackupSetRestore[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_name_search")
  @@index([email(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_email_search")
  @@index([role, suspended, id])
  @@index([suspended, id])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

model LibraryFolder {
  id         String @id @default(uuid())
  userId     String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  manualRank BigInt @default(dbgenerated("nextval('library_manual_rank_seq'::regclass)"))
  sets       StudySet[]
  viewerSets StudySetViewer[]
  coOwnedSets StudySetCoOwner[]

  @@unique([userId, id])
  @@unique([userId, name])
}

model StudySet {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  kind          String
  published     Boolean      @default(false)
  content       Json
  contentFingerprint String @default(dbgenerated())
  revision      Int          @default(1)
  course        String       @default("")
  folderId      String?
  folder        LibraryFolder? @relation(fields: [userId, folderId], references: [userId, id], onDelete: NoAction)
  manualRank    BigInt @default(dbgenerated("nextval('library_manual_rank_seq'::regclass)"))
  pinned        Boolean      @default(false)
  archived      Boolean      @default(false)
  lastStudiedAt DateTime?
  reviewLimit   Int          @default(20)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  attempts      Attempt[]
  cardReviews   CardReview[]
  viewers       StudySetViewer[]
  coOwners      StudySetCoOwner[]
  invitations   StudySetInvitation[]
  copyLink      StudySetCopyLink?
  copyImport    StudySetCopyImport?

  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "study_set_title_search")
  @@index([published, kind, id])
  @@index([published, id])
  @@index([userId, id])
  @@index([userId, updatedAt])
  @@index([userId, contentFingerprint])
  @@index([userId, archived, pinned, lastStudiedAt])
  @@index([userId, folderId, archived, manualRank])
}

model StudySetCoOwner {
  studySetId    String
  studySet      StudySet @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        String   @default("")
  folderId      String?
  folder        LibraryFolder? @relation(fields: [userId, folderId], references: [userId, id], onDelete: NoAction)
  manualRank    BigInt @default(dbgenerated("nextval('library_manual_rank_seq'::regclass)"))
  pinned        Boolean  @default(false)
  archived      Boolean  @default(false)
  lastStudiedAt DateTime?
  reviewLimit   Int      @default(20)
  cardReviews   CoOwnerCardReview[]

  @@id([studySetId, userId])
  @@index([userId, studySetId])
  @@index([userId, archived, pinned, lastStudiedAt])
  @@index([userId, folderId, archived, manualRank])
}

model CoOwnerCardReview {
  studySetId       String
  userId           String
  owner            StudySetCoOwner @relation(fields: [studySetId, userId], references: [studySetId, userId], onDelete: Cascade)
  cardId           String
  fingerprint      String
  streak           Int
  dueAt            DateTime
  attemptStartedAt DateTime

  @@id([studySetId, userId, cardId])
}

model StudySetInvitation {
  id         String   @id @default(uuid())
  studySetId String
  studySet   StudySet @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([studySetId, userId])
  @@index([userId, createdAt])
}

model StudySetCopyLink {
  studySetId String   @id
  studySet   StudySet @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  guestAccess Boolean @default(false)
  nonce      String   @unique
}

model StudySetCopyImport {
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String
  linkNonce String
  copyId    String?   @unique
  copy      StudySet? @relation(fields: [copyId], references: [id], onDelete: SetNull)

  @@id([userId, requestId])
}

model CardReview {
  studySetId       String
  studySet         StudySet @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  cardId           String
  fingerprint      String
  streak           Int
  dueAt            DateTime
  attemptStartedAt DateTime

  @@id([studySetId, cardId])
}

model Attempt {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySetId       String?
  studySet         StudySet? @relation(fields: [studySetId], references: [id], onDelete: SetNull)
  sourceAttemptId  String?
  sourceAttempt    Attempt?  @relation("Retries", fields: [sourceAttemptId], references: [id], onDelete: SetNull)
  retries          Attempt[] @relation("Retries")
  snapshotVersion  Int       @default(0)
  progressContent  Json?
  snapshot         Json
  studySetRevision Int?
  settings         Json      @default("{}")
  reviewMode       Boolean   @default(false)
  fullSet          Boolean   @default(true)
  status           String    @default("in_progress")
  responses        Json      @default("{}")
  position         Int       @default(0)
  result           Json?
  revision         Int       @default(1)
  startedAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  completedAt      DateTime?

  @@index([userId, startedAt])
  @@index([studySetId])
  @@index([sourceAttemptId])
  @@index([studySetId, reviewMode, completedAt])
}

model StudySetViewer {
  studySetId    String
  studySet      StudySet @relation(fields: [studySetId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        String   @default("")
  folderId      String?
  folder        LibraryFolder? @relation(fields: [userId, folderId], references: [userId, id], onDelete: NoAction)
  manualRank    BigInt @default(dbgenerated("nextval('library_manual_rank_seq'::regclass)"))
  pinned        Boolean  @default(false)
  archived      Boolean  @default(false)
  lastStudiedAt DateTime?
  reviewLimit   Int      @default(20)
  linkNonce     String?
  discovered    Boolean @default(false)
  cardReviews   ViewerCardReview[]

  @@id([studySetId, userId])
  @@index([userId, studySetId])
  @@index([userId, archived, pinned, lastStudiedAt])
  @@index([userId, folderId, archived, manualRank])
}

model ViewerCardReview {
  studySetId       String
  userId           String
  owner            StudySetViewer @relation(fields: [studySetId, userId], references: [studySetId, userId], onDelete: Cascade)
  cardId           String
  fingerprint      String
  streak           Int
  dueAt            DateTime
  attemptStartedAt DateTime

  @@id([studySetId, userId, cardId])
}


// Historical inventory and recovery records are retained independently of the live set.
model CloneConversion {
  copyId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  sourceId String?
  recovery Json?
  convertedAt DateTime?
  restoredCopyId String?
  @@index([userId, sourceId])
}

model LiveSetCutover {
  id Int @id
  completedAt DateTime?
}

model StudySetOperation {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId String
  operation String
  inputIdentity String
  setId String?
  reused Boolean @default(false)

  @@id([userId, requestId])
}

model BackupSetRestore {
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  backupId String
  sourceId String
  setId String
  contentFingerprint String
  destinationRevision Int

  @@id([userId, backupId, sourceId])
  @@unique([userId, backupId, setId])
}
